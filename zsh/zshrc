# ~/.zshrc — symlinked from ~/dotfiles/zsh/zshrc. Edit it here or there; it's the same file.
# Secrets and machine-specific settings go in ~/.zshrc.local (not in git).

# ---- Oh My Zsh ---------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting fast-syntax-highlighting)
source "$ZSH/oh-my-zsh.sh"

bindkey '^I' autosuggest-accept   # Tab accepts the grey autosuggestion

export HOMEBREW_NO_AUTO_UPDATE=1

# ---- Toolchain locations -----------------------------------------------------
export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/Library/pnpm"
export FLYCTL_INSTALL="$HOME/.fly"
export ANDROID_HOME="$HOME/Library/Android/sdk"
[[ -d /Library/Java/JavaVirtualMachines/zulu-17.jdk ]] &&
  export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home

# ---- PATH --------------------------------------------------------------------
# `typeset -U` drops duplicates. The `(N-/)` suffix keeps a directory only if it
# exists, so this works on a fresh Mac where some of these aren't installed yet.
typeset -U path
path=(
  $FLYCTL_INSTALL/bin(N-/)
  $PNPM_HOME(N-/)
  $HOME/.opencode/bin(N-/)
  ${HOMEBREW_PREFIX:-/opt/homebrew}/bin(N-/)
  $HOME/.local/bin(N-/)
  ${HOMEBREW_PREFIX:-/opt/homebrew}/opt/postgresql@18/bin(N-/)
  $BUN_INSTALL/bin(N-/)
  $path
  $ANDROID_HOME/emulator(N-/)
  $ANDROID_HOME/platform-tools(N-/)
)

# ---- nvm (loaded last so its node comes first in PATH) -----------------------
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

# bun completions (only present when bun came from its own installer)
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

# ---- Local overrides & secrets (never committed) -----------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
